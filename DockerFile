# Use the official Python image
FROM python:3.10-slim

# Install system dependencies required for Azure Speech SDK
RUN apt-get update && apt-get install -y \
    libasound2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    pkg-config \
    build-essential \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Azure Speech SDK explicitly with specific version
RUN pip install azure-cognitiveservices-speech==1.34.0

# Copy the rest of your app code
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV SPEECHSDK_ROOT=/usr/local/lib/python3.10/site-packages/azure/cognitiveservices/speech
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/site-packages/azure/cognitiveservices/speech:$LD_LIBRARY_PATH

# Run the LiveKit agent
CMD ["python", "main.py", "start"]