# Use Ubuntu instead of Debian slim - better Azure SDK compatibility
FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and comprehensive audio/system libraries
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    libasound2-dev \
    alsa-utils \
    pulseaudio \
    libpulse-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    pkg-config \
    build-essential \
    libc6-dev \
    ca-certificates \
    libffi-dev \
    libgcc-s1 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Create symbolic link for python
RUN ln -s /usr/bin/python3 /usr/bin/python

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Install Azure Speech SDK with specific version
RUN pip3 install azure-cognitiveservices-speech==1.34.0

# Copy the rest of your app code
COPY . .

# Set environment variables for headless operation
ENV PYTHONUNBUFFERED=1
ENV SPEECHSDK_ROOT=/usr/local/lib/python3.10/site-packages/azure/cognitiveservices/speech
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/site-packages/azure/cognitiveservices/speech:$LD_LIBRARY_PATH
ENV PULSE_RUNTIME_PATH=/tmp/pulse
ENV ALSA_PCM_CARD=default
ENV ALSA_PCM_DEVICE=0

# Create dummy audio devices for headless operation
RUN mkdir -p /tmp/pulse

# Run the LiveKit agent
CMD ["python3", "main.py", "start"]